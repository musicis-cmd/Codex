# Copiare in .env, senza includere credenziali nel repository.
HOST=127.0.0.1
PORT=3000
BASE_PATH=/mercato-usato
# Generare una password unica (almeno 16 caratteri). Nessuna password predefinita.
MUSICIS_ADMIN_PASSWORD=
# In produzione: NODE_ENV=production e indirizzo pubblico esatto.
PUBLIC_ORIGIN=https://www.musicis.it
# Impostare a 1 solo dopo aver completato e verificato l'informativa privacy.
MUSICIS_PRIVACY_APPROVED=0
# Directory persistenti, non pubblicate direttamente dal web server.
# DATA_DIR=/var/lib/musicis-usato/data
# UPLOAD_DIR=/var/lib/musicis-usato/uploads
# TRUST_PROXY=1 solo dietro un singolo reverse proxy fidato.
TRUST_PROXY=0
